#!/usr/bin/env bash
# Manual foreground development only. This script is not used by setup or CI.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/common
export PYTHONPATH="${PWD}${PYTHONPATH:+:${PYTHONPATH}}"
exec "${VEGVESEN_UV}" run --locked --no-sync hass --config "${PWD}/config" --debug
