{
  "name": "Statens vegvesen development",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.14.8" }
  },
  "postCreateCommand": "python -m pip install uv==0.12.22 && scripts/setup",
  "forwardPorts": [18123],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
